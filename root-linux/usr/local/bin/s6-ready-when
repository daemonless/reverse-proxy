#!/bin/sh
# Poll a command until it succeeds, then signal s6 readiness on fd 3
# (needs notification-fd = 3 in the service directory). Bounded, and dies
# with its service.
[ -n "$1" ] || { echo "Usage: s6-ready-when <command>"; exit 1; }
CHECK_CMD="$*"
SERVICE_PID=$PPID
(
    tries="${S6_READY_TIMEOUT:-300}"
    while ! eval "$CHECK_CMD" >/dev/null 2>&1; do
        kill -0 "$SERVICE_PID" 2>/dev/null || exit 0
        tries=$((tries - 1)); [ "$tries" -gt 0 ] || exit 0
        sleep 1
    done
    kill -0 "$SERVICE_PID" 2>/dev/null || exit 0
    printf "\n" >&3
) &
