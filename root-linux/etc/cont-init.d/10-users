#!/bin/sh
# PUID/PGID mapping for the admin, as the FreeBSD image does.
PUID="${PUID:-1000}"; PGID="${PGID:-1000}"
if [ "$(id -g bsd)" != "$PGID" ]; then delgroup bsd 2>/dev/null || true; addgroup -g "$PGID" bsd; fi
if [ "$(id -u bsd)" != "$PUID" ]; then deluser bsd 2>/dev/null || true; adduser -D -H -u "$PUID" -G bsd -s /sbin/nologin bsd; fi
echo "[usermod] User bsd configured (uid=$(id -u bsd), gid=$(id -g bsd))"
mkdir -p /config/logs && chown -R bsd:bsd /config
