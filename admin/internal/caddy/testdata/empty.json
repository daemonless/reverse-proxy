{
  "admin": {
    "config": {
      "persist": false
    },
    "listen": "unix//var/run/reverse-proxy/caddy.sock|0660",
    "origins": [
      "caddy"
    ]
  },
  "apps": {
    "http": {
      "servers": {
        "admin": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            ":8443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "match": [
                {
                  "path": [
                    "/internal/*"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "set": {
                        "X-Rp-Local-Addr": [
                          "{http.request.local.host}"
                        ]
                      }
                    }
                  },
                  "upstreams": [
                    {
                      "dial": "unix//var/run/reverse-proxy/admin.sock"
                    }
                  ]
                }
              ]
            }
          ],
          "tls_connection_policies": [
            {
              "certificate_selection": {
                "any_tag": [
                  "setup"
                ]
              },
              "default_sni": "reverse-proxy.setup",
              "protocol_min": "tls1.2"
            }
          ]
        },
        "trust": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            ":80"
          ],
          "protocols": [
            "h1"
          ],
          "routes": [
            {
              "handle": [
                {
                  "body": "ok\n",
                  "handler": "static_response",
                  "status_code": 200
                }
              ],
              "match": [
                {
                  "path": [
                    "/healthz"
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "set": {
                        "X-Rp-Local-Addr": [
                          "{http.request.local.host}"
                        ]
                      }
                    }
                  },
                  "upstreams": [
                    {
                      "dial": "unix//var/run/reverse-proxy/admin.sock"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "path": [
                    "/trust",
                    "/trust/*",
                    "/assets/*",
                    "/favicon.svg",
                    "/api/v1/trust",
                    "/api/v1/trust/*"
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "/trust"
                    ]
                  },
                  "status_code": 302
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "load_files": [
          {
            "certificate": "/config/secrets/setup.crt",
            "key": "/config/secrets/setup.key",
            "tags": [
              "setup"
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "admin",
          "admin.api"
        ],
        "level": "WARN"
      }
    }
  }
}
